# Planner model access (required for the real agent; `jive --demo` needs no keys).
OPENROUTER_API_KEY=
# Jev decision service (required for graphs that use `jev` nodes).
JEV_API_TOKEN=

# Optional: call Anthropic directly for anthropic/claude-* models instead of routing
# through OpenRouter. ANTHROPIC_OAUTH_TOKEN (from `claude setup-token`) is checked
# first and bills against your Claude subscription; ANTHROPIC_API_KEY is the
# pay-per-token fallback. Neither is required if you're happy routing Claude models
# through OpenRouter like any other model.
# ANTHROPIC_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Optional overrides. Defaults are shown.
# OPENROUTER_MODEL=google/gemini-3.8-flash
# JEV_MODEL=jev-1.13.0
