#!/usr/bin/env python3
"""wikigraph - data access for the English-Wikipedia flower-graph taskground.

Fetches flower terminals from Wikidata and link neighbourhoods from the
Wikipedia API. It only fetches, normalises, batches and caches; it runs no
graph algorithm. Python 3.9+, standard library only.

The anonymous Wikipedia API allows a burst of ~10 requests and then throttles
to roughly one request every few seconds, so every fetcher here batches up to
50 titles per request, caches complete results on disk, and shares one token
bucket across separate CLI invocations.
"""

import argparse
import fcntl
import gzip
import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API = "https://en.wikipedia.org/w/api.php"
SPARQL = "https://query.wikidata.org/sparql"
ROOT = os.path.dirname(os.path.abspath(__file__))
UA = os.environ.get(
    "WIKIGRAPH_UA",
    "wikigraph/0.2 (one-off Wikipedia graph research script; python-urllib)",
)
TOKEN = os.environ.get("WIKIGRAPH_TOKEN")  # optional Wikimedia OAuth bearer token

CFG = {
    "cache": os.path.join(ROOT, ".cache"),
    "use_cache": True,
    "timeout": 60,
    "rps": 0.15,
    "burst": 6.0,
    "max_requests": 400,
    "verbose": True,
}
COUNT = {"requests": 0, "throttled": 0, "cache_hits": 0}


# ------------------------------------------------------------------ plumbing

def die(message, code=2):
    print(json.dumps({"ok": False, "error": message, "requests": COUNT["requests"]}),
          file=sys.stderr)
    sys.exit(code)


def log(message):
    if CFG["verbose"]:
        print(f"[wikigraph] {message}", file=sys.stderr, flush=True)


def state_path():
    return os.path.join(CFG["cache"], "ratelimit.json")


class Bucket:
    """Token bucket shared by every wikigraph process through one state file."""

    def _open(self):
        os.makedirs(CFG["cache"], exist_ok=True)
        handle = open(state_path(), "a+", encoding="utf-8")
        fcntl.flock(handle, fcntl.LOCK_EX)
        handle.seek(0)
        try:
            state = json.loads(handle.read() or "{}")
        except json.JSONDecodeError:
            state = {}
        return handle, {
            "tokens": float(state.get("tokens", CFG["burst"])),
            "ts": float(state.get("ts", time.time())),
            "blocked_until": float(state.get("blocked_until", 0.0)),
        }

    def _close(self, handle, state):
        handle.seek(0)
        handle.truncate()
        handle.write(json.dumps(state))
        handle.flush()
        fcntl.flock(handle, fcntl.LOCK_UN)
        handle.close()

    def take(self):
        handle, state = self._open()
        try:
            now = time.time()
            if now < state["blocked_until"]:
                delay = min(120.0, state["blocked_until"] - now)
                log(f"throttled, waiting {delay:.0f}s")
                time.sleep(delay)
                now = time.time()
            tokens = min(CFG["burst"], state["tokens"] + (now - state["ts"]) * CFG["rps"])
            if tokens < 1.0:
                delay = min(120.0, (1.0 - tokens) / max(CFG["rps"], 0.001))
                time.sleep(delay)
                now = time.time()
                tokens = min(CFG["burst"], state["tokens"] + (now - state["ts"]) * CFG["rps"])
            self._close(handle, {"tokens": max(0.0, tokens - 1.0), "ts": now,
                                 "blocked_until": state["blocked_until"]})
        except BaseException:
            try:
                self._close(handle, state)
            except Exception:
                pass
            raise

    def penalise(self, retry_after):
        handle, state = self._open()
        now = time.time()
        self._close(handle, {"tokens": 0.0, "ts": now,
                             "blocked_until": now + max(retry_after, 5)})


BUCKET = Bucket()


def http_json(url, params, post=False, tries=5):
    body = urllib.parse.urlencode(params, doseq=True)
    target = url if post else f"{url}?{body}"
    headers = {"User-Agent": UA, "Accept": "application/json", "Accept-Encoding": "gzip"}
    if TOKEN:
        headers["Authorization"] = f"Bearer {TOKEN}"
    if post:
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    for attempt in range(tries):
        if COUNT["requests"] >= CFG["max_requests"]:
            die(f"stopped at --max-requests={CFG['max_requests']}; narrow the job "
                f"or raise the limit")
        BUCKET.take()
        COUNT["requests"] += 1
        request = urllib.request.Request(
            target, data=body.encode() if post else None, headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=CFG["timeout"]) as response:
                raw = response.read()
                if response.headers.get("Content-Encoding") == "gzip":
                    raw = gzip.decompress(raw)
            data = json.loads(raw.decode("utf-8"))
        except urllib.error.HTTPError as err:
            if err.code in (429, 500, 502, 503, 504) and attempt < tries - 1:
                try:
                    retry_after = int(err.headers.get("Retry-After", 0))
                except (TypeError, ValueError):
                    retry_after = 0
                COUNT["throttled"] += 1
                BUCKET.penalise(retry_after or 20 * (attempt + 1))
                continue
            die(f"HTTP {err.code} from {url}: "
                f"{err.read()[:300].decode('utf-8', 'replace')}")
        except (urllib.error.URLError, TimeoutError, OSError) as err:
            if attempt < tries - 1:
                time.sleep(2 ** attempt)
                continue
            die(f"network error contacting {url}: {err}")
        except json.JSONDecodeError as err:
            die(f"non-JSON response from {url}: {err}")
        if isinstance(data, dict) and data.get("error", {}).get("code") == "maxlag":
            time.sleep(5)
            continue
        if isinstance(data, dict) and "error" in data:
            die(f"API error: {json.dumps(data['error'])[:400]}")
        return data
    die(f"{url} failed after {tries} attempts")


def api_paged(params, collect):
    """action=query with continuation followed to exhaustion."""
    query = {"action": "query", "format": "json", "formatversion": 2, "maxlag": "5"}
    query.update(params)
    while True:
        data = http_json(API, query)
        collect(data)
        cont = data.get("continue")
        if not cont:
            return
        query.update(cont)


# ----------------------------------------------------------------- utilities

def norm_title(title):
    return re.sub(r"\s+", " ", str(title).replace("_", " ")).strip()


def is_identifier(title):
    """Citation pseudo-articles such as 'ISBN (identifier)'.

    Tens of thousands of pages link to them, so leaving them in makes every
    shortest path run through a citation template. Dropped unless --keep-identifiers.
    """
    return title.endswith("(identifier)")


def url_for(title):
    return "https://en.wikipedia.org/wiki/" + urllib.parse.quote(title.replace(" ", "_"))


def cache_path(kind, key):
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", key)[:80]
    digest = hashlib.sha1(key.encode("utf-8")).hexdigest()[:10]
    return os.path.join(CFG["cache"], kind, f"{safe}.{digest}.json")


def cache_get(kind, key):
    if not CFG["use_cache"]:
        return None
    path = cache_path(kind, key)
    if not os.path.exists(path):
        return None
    try:
        with open(path, encoding="utf-8") as handle:
            COUNT["cache_hits"] += 1
            return json.load(handle)
    except (OSError, json.JSONDecodeError):
        return None


def cache_put(kind, key, value):
    path = cache_path(kind, key)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(value, handle)
    os.replace(tmp, path)
    return value


def write_out(path, payload):
    directory = os.path.dirname(os.path.abspath(path))
    if directory:
        os.makedirs(directory, exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, ensure_ascii=False)
        handle.write("\n")
    return os.path.abspath(path)


def finish(args, summary, payload, preview=None):
    """Small summary on stdout; the full result goes to --out (or --print)."""
    if getattr(args, "out", None):
        summary["out"] = write_out(args.out, payload)
    if preview is not None:
        summary["preview"] = list(preview)[:10]
    summary = {"ok": True, **summary, "requests": COUNT["requests"],
               "cache_hits": COUNT["cache_hits"]}
    if COUNT["throttled"]:
        summary["throttled"] = COUNT["throttled"]
    if getattr(args, "print_full", False):
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    print(json.dumps(summary, ensure_ascii=False))


def read_titles(path):
    """Accept a JSON list, a JSON object with titles/nodes/flowers, or one per line."""
    with open(path, encoding="utf-8") as handle:
        text = handle.read().strip()
    titles = []
    if text.startswith("[") or text.startswith("{"):
        data = json.loads(text)
        if isinstance(data, dict):
            for key in ("titles", "nodes", "terminals", "flowers"):
                if isinstance(data.get(key), list):
                    data = data[key]
                    break
            else:
                data = []
        for item in data:
            if isinstance(item, str):
                titles.append(item)
            elif isinstance(item, dict):
                value = item.get("title") or item.get("id") or item.get("label")
                if value:
                    titles.append(value)
    else:
        header_skipped = False
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            value = line.split(",")[0].strip().strip('"')
            if not header_skipped and value.lower() in ("id", "title", "node", "label"):
                header_skipped = True
                continue
            titles.append(value)
    seen, ordered = set(), []
    for title in (norm_title(t) for t in titles):
        if title and title not in seen:
            seen.add(title)
            ordered.append(title)
    return ordered


def chunks(items, size):
    items = list(items)
    for start in range(0, len(items), size):
        yield items[start:start + size]


# ------------------------------------------------------------- wiki fetchers

def resolve_titles(titles):
    """Input title -> canonical article title, or None when the page is missing."""
    result, pending = {}, []
    for title in dict.fromkeys(norm_title(t) for t in titles):
        if not title:
            continue
        cached = cache_get("resolve", title)
        if cached is not None:
            result[title] = cached["to"]
        else:
            pending.append(title)
    if pending:
        log(f"resolving {len(pending)} titles")
    for batch in chunks(pending, 50):
        usable = [t for t in batch if "|" not in t]
        for title in batch:
            if "|" in title:
                result[title] = None
        if not usable:
            continue
        data = http_json(API, {
            "action": "query", "format": "json", "formatversion": 2,
            "titles": "|".join(usable), "redirects": 1, "maxlag": "5",
        })
        query = data.get("query", {})
        normalised = {n["from"]: n["to"] for n in query.get("normalized", [])}
        redirects = {r["from"]: r["to"] for r in query.get("redirects", [])}
        broken = {p.get("title") for p in query.get("pages", [])
                  if p.get("missing") or p.get("invalid")}
        for title in usable:
            current = normalised.get(title, title)
            for _ in range(5):
                if current not in redirects:
                    break
                current = redirects[current]
            target = None if current in broken else current
            result[title] = target
            cache_put("resolve", title, {"to": target})
    return result


def resolve_one(title):
    target = resolve_titles([title]).get(norm_title(title))
    if not target:
        die(f"no English Wikipedia article for {title!r}")
    return target


def resolve_list(titles):
    mapping = resolve_titles(titles)
    out, seen = [], set()
    for title in titles:
        target = mapping.get(norm_title(title))
        if target and target not in seen:
            seen.add(target)
            out.append(target)
    return out


DIRECTION_PARAMS = {
    "out": {"prop": "links", "plnamespace": 0, "pllimit": "max", "redirects": 1},
    "in": {"prop": "linkshere", "lhnamespace": 0, "lhlimit": "max",
           "lhshow": "!redirect", "redirects": 1},
}


def fetch_links(titles, direction, drop_identifiers=True):
    """{canonical title: [linked titles]} for direction 'out' or 'in'.

    Up to 50 titles per API request, continuation followed to exhaustion, each
    complete per-page result cached on disk.
    """
    kind = "links_out" if direction == "out" else "links_in"
    result, pending = {}, []
    for title in dict.fromkeys(titles):
        cached = cache_get(kind, title)
        if cached is not None:
            result[title] = cached
        else:
            pending.append(title)
    for index, batch in enumerate(chunks(pending, 50), start=1):
        log(f"fetching {direction}-links for {len(batch)} pages "
            f"(batch {index}/{-(-len(pending) // 50)})")
        collected = {title: [] for title in batch}
        field = "links" if direction == "out" else "linkshere"

        def collect(data, collected=collected):
            query = data.get("query", {})
            aliases = {r["to"]: r["from"] for r in query.get("redirects", [])}
            aliases.update({n["to"]: n["from"] for n in query.get("normalized", [])})
            for page in query.get("pages", []):
                key = page.get("title")
                for _ in range(4):  # walk normalisation/redirect hops back to the input
                    if key in collected or key is None:
                        break
                    key = aliases.get(key)
                if key not in collected:
                    log(f"warning: unmatched page {page.get('title')!r}; "
                        f"pass canonical titles (see: wikigraph resolve)")
                    continue
                for link in page.get(field, []) or []:
                    collected[key].append(link["title"])

        api_paged({**DIRECTION_PARAMS[direction], "titles": "|".join(batch)}, collect)
        for title, links in collected.items():
            result[title] = cache_put(kind, title, list(dict.fromkeys(links)))
    if drop_identifiers:
        return {title: [t for t in links if not is_identifier(t)]
                for title, links in result.items()}
    return result


def fetch_redirects(titles):
    """alias title -> canonical title, for every redirect pointing at titles."""
    aliases = {}
    for batch in chunks([t for t in titles if "|" not in t], 50):
        def collect(data):
            for page in data.get("query", {}).get("pages", []):
                for red in page.get("redirects", []) or []:
                    aliases[norm_title(red["title"])] = page["title"]
        api_paged({"titles": "|".join(batch), "prop": "redirects",
                   "rdnamespace": 0, "rdlimit": "max"}, collect)
    return aliases


def undirected(out_map, in_map):
    """Merge directed link maps into {title: {neighbour: 'out'|'in'|'both'}}."""
    merged = {}
    for title in set(out_map) | set(in_map):
        entry = {}
        for neighbour in out_map.get(title, []):
            if neighbour != title:
                entry[neighbour] = "out"
        for neighbour in in_map.get(title, []):
            if neighbour == title:
                continue
            entry[neighbour] = "both" if entry.get(neighbour) == "out" else "in"
        merged[title] = entry
    return merged


# ------------------------------------------------------------------ commands

FLOWER_MODES = {
    "any": "{ ?item wdt:P31/wdt:P279* wd:Q506 } UNION { ?item wdt:P279* wd:Q506 }",
    "instances": "?item wdt:P31 wd:Q506 .",
    "instance-tree": "?item wdt:P31/wdt:P279* wd:Q506 .",
    "subclasses": "?item wdt:P279* wd:Q506 .",
}


def run_sparql(query, endpoint=None):
    return http_json(endpoint or SPARQL, {"query": query, "format": "json"}, post=True)


def cmd_flowers(args):
    query = (
        "SELECT DISTINCT ?item ?itemLabel ?article WHERE {\n"
        f"  {FLOWER_MODES[args.mode]}\n"
        "  ?article schema:about ?item ;\n"
        "           schema:isPartOf <https://en.wikipedia.org/> .\n"
        '  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }\n'
        "}" + (f"\nLIMIT {args.limit}" if args.limit else "")
    )
    rows, seen = [], set()
    for binding in run_sparql(query, args.endpoint).get("results", {}).get("bindings", []):
        article = binding["article"]["value"]
        title = norm_title(urllib.parse.unquote(article.rsplit("/", 1)[-1]))
        if title in seen:
            continue
        seen.add(title)
        rows.append({
            "qid": binding["item"]["value"].rsplit("/", 1)[-1],
            "label": binding.get("itemLabel", {}).get("value", title),
            "title": title,
            "url": article,
        })
    rows.sort(key=lambda row: row["title"])
    if args.resolve:
        mapping = resolve_titles([row["title"] for row in rows])
        for row in rows:
            row["article"] = mapping.get(row["title"])
    payload = {"mode": args.mode, "query": query, "count": len(rows), "flowers": rows}
    finish(args, {"command": "flowers", "mode": args.mode, "count": len(rows)},
           payload, preview=[row["title"] for row in rows])


def cmd_sparql(args):
    if not args.query and not args.query_file:
        die("sparql needs --query or --query-file")
    query = args.query or open(args.query_file, encoding="utf-8").read()
    data = run_sparql(query, args.endpoint)
    bindings = data.get("results", {}).get("bindings", [])
    finish(args, {"command": "sparql", "rows": len(bindings)}, data,
           preview=[{k: v.get("value") for k, v in b.items()} for b in bindings])


def cmd_resolve(args):
    titles = list(args.titles) + (read_titles(args.titles_file) if args.titles_file else [])
    mapping = resolve_titles(titles)
    missing = sorted(t for t, v in mapping.items() if v is None)
    finish(args, {"command": "resolve", "count": len(mapping), "missing": len(missing)},
           {"resolved": mapping, "missing": missing},
           preview=[f"{k} -> {v}" for k, v in mapping.items()])


def cmd_neighbors(args):
    title = resolve_one(args.title)
    drop = not args.keep_identifiers
    out_map = fetch_links([title], "out", drop) if args.direction in ("both", "out") else {}
    in_map = fetch_links([title], "in", drop) if args.direction in ("both", "in") else {}
    entry = undirected(out_map, in_map).get(title, {})
    payload = {
        "title": title,
        "url": url_for(title),
        "direction": args.direction,
        "out": sorted(out_map.get(title, [])),
        "in": sorted(in_map.get(title, [])),
        "neighbors": {k: entry[k] for k in sorted(entry)},
    }
    finish(args, {"command": "neighbors", "title": title,
                  "out_links": len(payload["out"]), "in_links": len(payload["in"]),
                  "union": len(entry)}, payload, preview=sorted(entry))


def cmd_expand(args):
    seeds = list(args.title) + (read_titles(args.titles_file) if args.titles_file else [])
    if not seeds:
        die("expand needs --title or --titles-file")
    seeds = resolve_list(seeds)
    drop = not args.keep_identifiers
    edges, degree, known = {}, {}, set(seeds)
    expanded = []
    frontier = list(seeds)

    for hop in range(1, args.hops + 1):
        todo = [t for t in frontier if t not in degree]
        if not todo:
            break
        log(f"hop {hop}: expanding {len(todo)} pages")
        out_map = fetch_links(todo, "out", drop) if args.direction in ("both", "out") else {}
        in_map = fetch_links(todo, "in", drop) if args.direction in ("both", "in") else {}
        merged = undirected(out_map, in_map)
        discovered = []
        for source, entry in merged.items():
            neighbours = list(entry)
            if args.max_per_page:
                neighbours = neighbours[:args.max_per_page]
            degree[source] = len(neighbours)
            expanded.append(source)
            for neighbour in neighbours:
                key = tuple(sorted((source, neighbour)))
                direction = entry[neighbour]
                record = edges.setdefault(key, {"a": key[0], "b": key[1], "observed": set()})
                if direction in ("out", "both"):
                    record["observed"].add(f"{source}->{neighbour}")
                if direction in ("in", "both"):
                    record["observed"].add(f"{neighbour}->{source}")
                if neighbour not in known:
                    known.add(neighbour)
                    discovered.append(neighbour)
        frontier = discovered
        if args.max_nodes and len(known) >= args.max_nodes:
            log(f"stopping: {len(known)} nodes reached --max-nodes")
            break

    edge_list = [{"a": e["a"], "b": e["b"], "observed": sorted(e["observed"])}
                 for e in sorted(edges.values(), key=lambda e: (e["a"], e["b"]))]
    payload = {
        "seeds": seeds,
        "direction": args.direction,
        "hops": args.hops,
        "nodes": sorted(known),
        "edges": edge_list,
        "expanded": {title: degree[title] for title in sorted(degree)},
        "stats": {"seeds": len(seeds), "expanded": len(expanded),
                  "nodes": len(known), "edges": len(edge_list)},
    }
    finish(args, {"command": "expand", "seeds": len(seeds), "hops": args.hops,
                  "expanded": len(expanded), "nodes": len(known),
                  "edges": len(edge_list)}, payload, preview=sorted(known))


def cmd_induced(args):
    nodes = list(args.node) + (read_titles(args.nodes_file) if args.nodes_file else [])
    nodes = resolve_list(nodes)
    if len(nodes) < 2:
        die("induced needs at least two resolvable nodes")
    lookup = {node: node for node in nodes}
    aliases = {}
    if not args.no_aliases:
        aliases = fetch_redirects(nodes)
        lookup.update(aliases)
    out_map = fetch_links(nodes, "out", not args.keep_identifiers)
    pairs = {}
    for source, links in out_map.items():
        for link in links:
            target = lookup.get(norm_title(link))
            if not target or target == source:
                continue
            key = tuple(sorted((source, target)))
            pairs.setdefault(key, {"a": key[0], "b": key[1], "observed": set()})
            pairs[key]["observed"].add(f"{source}->{target}")
    edge_list = [{"a": e["a"], "b": e["b"], "observed": sorted(e["observed"])}
                 for e in sorted(pairs.values(), key=lambda e: (e["a"], e["b"]))]
    payload = {
        "nodes": nodes,
        "edges": edge_list,
        "aliases": aliases if args.keep_alias_map else {},
        "stats": {"nodes": len(nodes), "edges": len(edge_list), "aliases": len(aliases)},
    }
    finish(args, {"command": "induced", "nodes": len(nodes), "edges": len(edge_list)},
           payload, preview=[f'{e["a"]} -- {e["b"]}' for e in edge_list])


def cmd_check_links(args):
    source = resolve_one(args.source)
    targets = list(args.to) + (read_titles(args.to_file) if args.to_file else [])
    targets = resolve_list(targets)
    if not targets:
        die("check-links needs --to or --to-file")
    forward, backward = [], []
    for batch in chunks(targets, 50):
        def collect_forward(data):
            for page in data.get("query", {}).get("pages", []):
                for link in page.get("links", []) or []:
                    forward.append(link["title"])
        api_paged({"titles": source, "prop": "links", "plnamespace": 0,
                   "pllimit": "max", "redirects": 1, "pltitles": "|".join(batch)},
                  collect_forward)
        if args.both:
            def collect_backward(data):
                for page in data.get("query", {}).get("pages", []):
                    if page.get("links"):
                        backward.append(page["title"])
            api_paged({"titles": "|".join(batch), "prop": "links", "plnamespace": 0,
                       "pllimit": "max", "redirects": 1, "pltitles": source},
                      collect_backward)
    payload = {"source": source, "targets": targets,
               "links_to": sorted(set(forward)), "linked_from": sorted(set(backward))}
    finish(args, {"command": "check-links", "source": source, "targets": len(targets),
                  "links_to": len(set(forward)), "linked_from": len(set(backward))},
           payload, preview=sorted(set(forward)))


def cmd_cache(args):
    if args.action == "path":
        print(json.dumps({"ok": True, "cache": CFG["cache"]}))
        return
    total, files = 0, 0
    for base, _, names in os.walk(CFG["cache"]):
        for name in names:
            path = os.path.join(base, name)
            files += 1
            total += os.path.getsize(path)
            if args.action == "clear":
                os.remove(path)
    print(json.dumps({"ok": True, "cache": CFG["cache"], "files": files,
                      "bytes": total, "cleared": args.action == "clear"}))


# -------------------------------------------------------------------- parser

def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--out", help="write the full JSON result to this file")
    common.add_argument("--print", dest="print_full", action="store_true",
                        help="also dump the full JSON result to stdout")
    common.add_argument("--cache-dir", default=CFG["cache"])
    common.add_argument("--no-cache", action="store_true")
    common.add_argument("--rps", type=float, default=CFG["rps"],
                        help="sustained requests per second (default 0.15)")
    common.add_argument("--burst", type=float, default=CFG["burst"])
    common.add_argument("--max-requests", type=int, default=CFG["max_requests"],
                        help="abort once this many HTTP requests have been made")
    common.add_argument("--timeout", type=int, default=CFG["timeout"])
    common.add_argument("--quiet", action="store_true", help="no progress on stderr")

    parser = argparse.ArgumentParser(
        prog="wikigraph", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("flowers", parents=[common], help="flower articles from Wikidata")
    p.add_argument("--mode", choices=sorted(FLOWER_MODES), default="any",
                   help="any: P31/P279* Q506 union P279* Q506 (default)")
    p.add_argument("--limit", type=int)
    p.add_argument("--resolve", action="store_true",
                   help="also record the canonical article each sitelink redirects to")
    p.add_argument("--endpoint")
    p.set_defaults(func=cmd_flowers)

    p = sub.add_parser("sparql", parents=[common], help="raw Wikidata SPARQL query")
    p.add_argument("--query")
    p.add_argument("--query-file")
    p.add_argument("--endpoint")
    p.set_defaults(func=cmd_sparql)

    p = sub.add_parser("resolve", parents=[common],
                       help="normalise titles and follow redirects")
    p.add_argument("titles", nargs="*")
    p.add_argument("--titles-file")
    p.set_defaults(func=cmd_resolve)

    p = sub.add_parser("neighbors", parents=[common],
                       help="undirected neighbourhood of one article")
    p.add_argument("title")
    p.add_argument("--direction", choices=["both", "out", "in"], default="both")
    p.add_argument("--keep-identifiers", action="store_true")
    p.set_defaults(func=cmd_neighbors)

    p = sub.add_parser("expand", parents=[common],
                       help="crawl neighbourhoods into a node/edge list")
    p.add_argument("--title", action="append", default=[])
    p.add_argument("--titles-file")
    p.add_argument("--hops", type=int, default=1)
    p.add_argument("--direction", choices=["both", "out", "in"], default="both")
    p.add_argument("--max-per-page", type=int, help="cap neighbours kept per page")
    p.add_argument("--max-nodes", type=int, help="stop after this many distinct nodes")
    p.add_argument("--keep-identifiers", action="store_true")
    p.set_defaults(func=cmd_expand)

    p = sub.add_parser("induced", parents=[common],
                       help="edges among a fixed node set (final-answer verification)")
    p.add_argument("--node", action="append", default=[])
    p.add_argument("--nodes-file")
    p.add_argument("--no-aliases", action="store_true",
                   help="skip redirect-alias matching (faster, less accurate)")
    p.add_argument("--keep-alias-map", action="store_true")
    p.add_argument("--keep-identifiers", action="store_true")
    p.set_defaults(func=cmd_induced)

    p = sub.add_parser("check-links", parents=[common], help="does A link to B, C, D?")
    p.add_argument("source")
    p.add_argument("--to", action="append", default=[])
    p.add_argument("--to-file")
    p.add_argument("--both", action="store_true", help="also test the reverse direction")
    p.set_defaults(func=cmd_check_links)

    p = sub.add_parser("cache", help="inspect or clear the on-disk cache")
    p.add_argument("action", choices=["stats", "clear", "path"], nargs="?", default="stats")
    p.add_argument("--cache-dir", default=CFG["cache"])
    p.set_defaults(func=cmd_cache)
    return parser


def main():
    args = build_parser().parse_args()
    CFG["cache"] = os.path.abspath(getattr(args, "cache_dir", CFG["cache"]))
    CFG["use_cache"] = not getattr(args, "no_cache", False)
    CFG["timeout"] = getattr(args, "timeout", CFG["timeout"])
    CFG["rps"] = max(0.01, getattr(args, "rps", CFG["rps"]))
    CFG["burst"] = max(1.0, getattr(args, "burst", CFG["burst"]))
    CFG["max_requests"] = getattr(args, "max_requests", CFG["max_requests"])
    CFG["verbose"] = not getattr(args, "quiet", False)
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        die("interrupted", 130)
