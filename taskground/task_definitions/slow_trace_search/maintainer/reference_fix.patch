+def prepare_query(query: Mapping[str, Any]) -> dict[str, Any]:
+    """Normalize invariant query values once per search."""
+    prepared: dict[str, Any] = {}
+    if "min_timestamp" in query:
+        prepared["min_timestamp"] = int(query["min_timestamp"])
+    if "max_timestamp" in query:
+        prepared["max_timestamp"] = int(query["max_timestamp"])
+    for name in ("levels", "services", "tags"):
+        if query.get(name):
+            prepared[name] = _normalized_set(query[name])
+    if query.get("terms"):
+        prepared["terms"] = tuple(normalize_text(value) for value in query["terms"])
+    return prepared
+
+
+def matches(record: Mapping[str, Any], query: Mapping[str, Any]) -> bool:
+    """Return whether a normalized trace record satisfies a prepared query."""
+    if "min_timestamp" in query and int(record["timestamp"]) < query["min_timestamp"]:
         return False
-    if "max_timestamp" in query and int(field(line, "timestamp")) > int(query["max_timestamp"]):
+    if "max_timestamp" in query and int(record["timestamp"]) > query["max_timestamp"]:
         return False
-    if query.get("levels") and field(line, "level") not in _normalized_set(query["levels"]):
+    if query.get("levels") and record["level"] not in query["levels"]:
         return False
-    if query.get("services") and field(line, "service") not in _normalized_set(query["services"]):
+    if query.get("services") and record["service"] not in query["services"]:
         return False
     if query.get("tags"):
-        record_tags = set(field(line, "tags"))
-        if not _normalized_set(query["tags"]).issubset(record_tags):
+        if not query["tags"].issubset(set(record["tags"])):
             return False
     if query.get("terms"):
-        message = field(line, "message")
-        if not all(normalize_text(term) in message for term in query["terms"]):
+        if not all(term in record["message"] for term in query["terms"]):
             return False
     return True
