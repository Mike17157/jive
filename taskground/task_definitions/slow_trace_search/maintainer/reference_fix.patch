--- a/tracequery/reader.py
+++ b/tracequery/reader.py
@@ -44,3 +44,11 @@ def iter_lines(path: str | Path) -> Iterator[str]:
         for line in handle:
             if line.strip():
                 yield line
+
+
+def iter_records(path: str | Path) -> Iterator[dict[str, Any]]:
+    """Decode each non-blank line exactly once."""
+    with Path(path).open("r", encoding="utf-8") as handle:
+        for line in handle:
+            if line.strip():
+                yield decode_line(line)
